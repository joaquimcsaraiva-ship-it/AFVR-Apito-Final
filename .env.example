PORT=5002

# Local PostgreSQL configuration. Used when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=afvr_resultados
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Supabase/hosted PostgreSQL: paste the Session Pooler connection URI here.
# The application enforces TLS and certificate verification for DATABASE_URL.
DATABASE_URL=

# Authentication for the AFVR administration panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:<salt-hex>:<hash-hex>
AUTH_TOKEN_SECRET=<random-secret-of-at-least-32-characters>